---
import '../styles/global.css';
import { site } from '../data/site';
const { title = site.name, description = site.shortIntro } = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f3ee" />
    <title>{title} · {site.name}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="wordmark" href="/" aria-label="Jonathan Tobias home"><span class="wordmark-mark">JT</span><span>JONATHAN TOBIAS<span class="wordmark-sub">ENGINEERING PORTFOLIO</span></span></a>
        <nav class="main-nav" aria-label="Main navigation">
          <a class:list={[{ active: path === '/' }]} href="/">Home</a>
          <a class:list={[{ active: path.startsWith('/experience') }]} href="/experience/">Experience</a>
          <a class:list={[{ active: path.startsWith('/projects') }]} href="/projects/">Projects</a>
          <a class:list={[{ active: path.startsWith('/about') }]} href="/about/">About</a>
        </nav>
        <div class="header-actions">
          <a class="contact-link" href={`mailto:${site.email}`}>Contact <span>↗</span></a>
        </div>
      </header>
      <main><slot /></main>
      <footer class="site-footer">
        <div><span class="footer-mark">JT</span></div>
        <div class="footer-links"><a href={site.github} target="_blank" rel="noreferrer">GitHub ↗</a><a href={site.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a><span>© {new Date().getFullYear()} Jonathan Tobias</span></div>
      </footer>
    </div>
  </body>
</html>
