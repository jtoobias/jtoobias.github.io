---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site } from '../data/site';
import { projects } from '../data/projects';
const featured = projects.slice(0, 3);
---
<BaseLayout title="Home">
  <section class="hero">
    <div class="hero-copy">
      <div class="eyebrow"><span class="status-dot"></span>{site.availability}</div>
      <h1>Engineering ideas<br/><span>into real systems.</span></h1>
      <p class="hero-intro">{site.intro}</p>
      <div class="hero-actions"><a class="button button-dark" href="/projects/">Explore selected work <span>↗</span></a><a class="text-link" href="/about/">A little about me <span>→</span></a></div>
      <div class="hero-location"><span class="tiny-cross">✳</span> {site.location} <span class="location-divider">/</span> Originally from Aotearoa New Zealand</div>
    </div>
    <div class="hero-visual" aria-label="Abstract technical illustration">
      <div class="visual-topline"><span>ENGINEERING / 001</span><span>52°05′ N — 5°07′ E</span></div>
      <div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div>
      <div class="core"><span>JT</span><small>BUILD / TEST / REFINE</small></div>
      <div class="visual-label label-a">HARDWARE<br/><b>PCB · MCU</b></div>
      <div class="visual-label label-b">SOFTWARE<br/><b>C++ · PYTHON</b></div>
      <div class="visual-label label-c">SYSTEMS<br/><b>ROBOTICS · IoT</b></div>
      <div class="visual-coordinate">N 52°05' / E 05°07'</div>
    </div>
  </section>

  <section class="intro-strip">
    <div class="section-kicker">01 / WHAT I DO</div>
    <p>Curious by nature. Practical by design. I enjoy working across disciplines to turn complex technical problems into <em>reliable, useful products.</em></p>
    <a href="/experience/" class="round-link" aria-label="View experience">↗</a>
  </section>

  <section class="section-block">
    <div class="section-heading"><div><div class="section-kicker">02 / SELECTED WORK</div><h2>Projects &amp; engineering</h2></div><a class="text-link" href="/projects/">View all projects <span>→</span></a></div>
    <div class="project-grid">{featured.map((project, i) => <ProjectCard project={project} index={`0${i + 1}`} />)}</div>
  </section>

  <section class="experience-preview">
    <div class="section-kicker">03 / EXPERIENCE</div>
    <div class="experience-preview-main"><h2>Different industries.<br/><span>One engineering mindset.</span></h2><div class="experience-list">{site.experience.map((job) => <a href="/experience/" class="experience-row"><span class="experience-period">{job.period}</span><span class="experience-company">{job.company}</span><span class="experience-role">{job.role}</span><span class="row-arrow">↗</span></a>)}</div></div>
    <a class="text-link" href="/experience/">More about my experience <span>→</span></a>
  </section>

  <section class="closing-cta"><div class="section-kicker">HAVE A PROJECT IN MIND?</div><h2>Let's make something<br/><em>work beautifully.</em></h2><a class="button button-light" href={`mailto:${site.email}`}>Get in touch <span>↗</span></a><div class="cta-fern">✳</div></section>
</BaseLayout>
