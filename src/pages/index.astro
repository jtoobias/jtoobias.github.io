---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import HeroMedia from '../components/HeroMedia.astro';
import { site } from '../data/site';
import { projects, featuredSlugs } from '../data/projects';
const featured = featuredSlugs.map((s) => projects.find((p) => p.slug === s)).filter(Boolean);
---
<BaseLayout title="Home">
  <section class="hero" id="hero">
    <div class="hero-copy">
      <div class="eyebrow"><span class="status-dot"></span>{site.availability}</div>
      <h1>Hello.<br/><span>I build embedded systems and robots.</span></h1>
      <p class="hero-intro">{site.intro}</p>
      <div class="trait-grid">
        <div>
          <h2>Strengths</h2>
          <ul>{site.strengths.map((item) => <li>{item}</li>)}</ul>
        </div>
        <div>
          <h2>Weaknesses</h2>
          <ul>{site.weaknesses.map((item) => <li>{item}</li>)}</ul>
        </div>
      </div>
      <div class="hero-actions"><a class="button button-dark" href="/projects/">See the work <span>→</span></a><a class="text-link" href="/about/">A little about me <span>→</span></a></div>
      <div class="hero-location"><span class="tiny-cross">✳</span> {site.location} <span class="location-divider">/</span> Originally from Aotearoa New Zealand</div>
    </div>
    <HeroMedia item={site.heroMedia} />
  </section>

  <section class="section-block">
    <div class="section-heading"><div><div class="section-kicker">PORTFOLIO</div><h2>Projects</h2></div><a class="text-link" href="/projects/">View all projects <span>→</span></a></div>
    <div class="project-grid">{featured.map((project, i) => <ProjectCard project={project} index={`0${i + 1}`} />)}</div>
  </section>

  <section class="experience-preview">
    <div class="section-kicker">EXPERIENCE</div>
    <div class="experience-preview-main"><h2>Different industries.<br/><span>One engineering mindset.</span></h2><div class="experience-list">{site.experience.map((job) => <a href={`/experience/#${job.id}`} class="experience-row"><span class="experience-period">{job.period}</span><span class="experience-company">{job.company}</span><span class="experience-role">{job.role}</span><span class="row-arrow">→</span></a>)}</div></div>
    <a class="text-link" href="/experience/">More about my experience <span>→</span></a>
  </section>

  <section class="closing-cta"><div class="section-kicker">HAVE A PROJECT IN MIND?</div><h2>Let's talk about<br/><em>what you're building.</em></h2><a class="button button-light" href={`mailto:${site.email}`}>Get in touch <span>↗</span></a><div class="cta-fern">✳</div></section>
</BaseLayout>
