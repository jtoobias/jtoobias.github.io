---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---
<BaseLayout title="About" description="A little more about Jonathan Tobias.">
  <section class="page-hero"><div class="section-kicker">A LITTLE CONTEXT / 04</div><h1>Engineer by trade.<br/><em>Curious by default.</em></h1><p>I'm an engineer who enjoys understanding how things work — and then figuring out how to make them work better.</p></section>
  <section class="about-layout"><div class="about-stamp"><div class="stamp-ring">AOTEAROA · NEDERLAND · ENGINEERING ·</div><div class="stamp-center">JT<span>✳</span></div><div class="stamp-coordinates">41°17′ S<br/>174°46′ E</div></div><div class="about-copy"><div class="section-kicker">THE SHORT VERSION</div><p class="about-lead">Originally from Aotearoa New Zealand, now based in the Netherlands.</p><p>My background spans electronics, embedded firmware and robotics. I've worked on everything from microcontroller-based systems to autonomous agricultural machinery and integrated hardware/software products.</p><p>I enjoy the variety that comes with engineering across disciplines: understanding a system as a whole, getting into the details, testing assumptions and solving the practical problems that make a product reliable.</p><p>Outside engineering, I enjoy staying active, exploring new places and learning new things.</p><div class="about-links"><a href={site.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a><a href={site.github} target="_blank" rel="noreferrer">GitHub ↗</a><a href={`mailto:${site.email}`}>Email ↗</a></div></div></section>
  <section class="journey-strip"><div class="section-kicker">A CHANGE OF HEMISPHERE</div><div class="journey"><div><span>01 / ORIGIN</span><strong>New Zealand</strong><small>Southern Hemisphere</small></div><div class="journey-line"><span>✳</span></div><div><span>02 / CURRENTLY</span><strong>The Netherlands</strong><small>Utrecht region</small></div></div></section>
</BaseLayout>
