---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---
<BaseLayout title="About" description="A little more about Jonathan Tobias."> 
  <section class="page-hero"><div class="section-kicker">A LITTLE CONTEXT</div><h1>Engineering at the intersection<br/><span>of hardware and code.</span></h1>
  <p>What drives me as an engineer is solving real-world problems, and learning along the way. The most rewarding work is building things that make someone's day easier, or make an everyday task more reliable.</p></section>
  <section class="about-layout"><div class="about-stamp"><div class="stamp-ring">AOTEAROA · NEDERLAND · ENGINEERING ·</div><div class="stamp-center">JT<span>✳</span></div><div class="stamp-coordinates">37.78° S<br/>175.28° E</div></div><div class="about-copy"><div class="section-kicker">THE SHORT VERSION</div><p class="about-lead">Originally from Aotearoa New Zealand, now based in the Netherlands.</p>
  <p>My background spans electronics, embedded firmware and robotics. I have worked on everything from bare-metal microcontroller systems to autonomous agricultural machinery, bringing hardware and software together along the way.</p>
  <p>I enjoy engineering across disciplines: learning the system as a whole, getting into the details, testing assumptions and solving the practical problems that make a product reliable.</p>
  <p>Outside engineering, I enjoy staying active through a variety of sports, exploring new places and learning new things.</p>
  <div class="about-links"><a href={site.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a><a href={site.github} target="_blank" rel="noreferrer">GitHub ↗</a><a href="/CV-Jonathan-Tobias.pdf" download>Resume ↓</a><a href={`mailto:${site.email}`}>Email ↗</a></div></div></section>
  <section class="about-traits">
    <div class="trait-grid">
      <div>
        <h2>Strengths</h2>
        <ul>{site.strengths.map((item) => <li>{item}</li>)}</ul>
      </div>
      <div>
        <h2>Weaknesses</h2>
        <ul>{site.weaknesses.map((item) => <li>{item}</li>)}</ul>
      </div>
    </div>
  </section>
  <section class="journey-strip"><div class="section-kicker">A CHANGE OF HEMISPHERE</div><div class="journey"><div><span>01 / ORIGIN</span><strong>New Zealand</strong><small>Southern Hemisphere</small></div><div class="journey-line"><span>✳</span></div><div><span>02 / CURRENTLY</span><strong>The Netherlands</strong><small>Utrecht region</small></div></div></section>
</BaseLayout>
